{
    "name": "kirschbaum-development/laravel-php-upgrader",
    "description": "Inspect and apply PHP patch updates across hosting providers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/prompts": "^0.3",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {"psr-4": {"KirschbaumDevelopment\\LaravelPhpUpgrader\\": "src/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "bin": ["bin/laravel-php-upgrader"],
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {"sort-packages": true, "platform": {"php": "8.2.0"}},
    "extra": {"branch-alias": {"dev-main": "0.1.x-dev"}}
}
